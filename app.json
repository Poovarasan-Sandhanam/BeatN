{
  "expo": {
    "name": "BeatN",
    "slug": "BeatN",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "beatn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.beatn.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "BeatN uses your microphone to record voice journal entries. Recordings are transcribed on this device.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "6J75KC7K4S",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      }
    },
    "android": {
      "package": "com.beatn.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#4251A8"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-audio",
        {
          "microphonePermission": "BeatN uses your microphone to record voice journal entries. Recordings are transcribed on this device.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "withSQLiteVecExtension": false,
          "useSQLCipher": true
        }
      ],
      "expo-asset",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 88,
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EE",
          "dark": {
            "image": "./assets/splash-mark-dark.png",
            "backgroundColor": "#0F0E11"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "BeatN uses Face ID to keep your journal private."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BeatN uses Face ID to keep your journal private."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "82f48f58-4416-4d45-abc8-e1b7d1217e36"
      }
    },
    "owner": "poovarasanksp"
  }
}
