{
  "cli": {
    "version": ">= 24.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "beta": {
      "extends": "production",
      "distribution": "store"
    }
  },
  "submit": {
    "production": {},
    "beta": {
      "ios": {
        "appleTeamId": "6J75KC7K4S"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "closed": {
      "extends": "beta",
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    }
  }
}
