diff --git a/node_modules/expo-modules-jsi/apple/Sources/ExpoModulesJSI/Utilities/NonisolatedUnsafeVar.swift b/node_modules/expo-modules-jsi/apple/Sources/ExpoModulesJSI/Utilities/NonisolatedUnsafeVar.swift
index e9c0c43..a5be3a2
--- a/node_modules/expo-modules-jsi/apple/Sources/ExpoModulesJSI/Utilities/NonisolatedUnsafeVar.swift
+++ b/node_modules/expo-modules-jsi/apple/Sources/ExpoModulesJSI/Utilities/NonisolatedUnsafeVar.swift
@@ -9,3 +9,21 @@ internal final class NonisolatedUnsafeVar<VarType>: Sendable {
     self.value = value
   }
 }
+
+/// Allocation-free counterpart to ``NonisolatedUnsafeVar`` for values that only need to cross a
+/// concurrency domain, not be mutated across one.
+///
+/// `nonisolated(unsafe)` on a local `let` is not honoured by region isolation in Swift 6.2.4: the
+/// binding stays task-isolated and is rejected as soon as a global-actor-isolated closure captures
+/// it ("sending 'x' risks causing data races"). Wrapping the value in a `Sendable` type sidesteps
+/// the check the same way ``NonisolatedUnsafeVar`` does, but as a struct it costs no per-call class
+/// allocation — which matters on the host-call path, where that allocation was profiled out.
+///
+/// Use with extreme caution as it bypasses Swift's concurrency safety checks.
+internal struct NonisolatedUnsafeValue<Wrapped>: @unchecked Sendable {
+  let value: Wrapped
+
+  init(_ value: Wrapped) {
+    self.value = value
+  }
+}
