# Copy to fastlane/.env and fill in. fastlane/.env is gitignored — never commit it.
# Fastlane loads this file automatically.

# --- App Store Connect API key (TestFlight) ------------------------------
# App Store Connect → Users and Access → Integrations → App Store Connect API
# Create a key with the "App Manager" role and download the .p8 (only once!).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Comma-separated external TestFlight groups. Leave empty to ship to internal
# testers only (no Apple beta review needed).
TESTFLIGHT_GROUPS=

# --- Google Play service account (internal / closed testing) -------------
# Google Cloud service account JSON with access granted in Play Console.
PLAY_JSON_KEY_PATH=/absolute/path/to/play-service-account.json

# 'draft' until the app has finished first-time Play Console setup, then 'completed'.
PLAY_RELEASE_STATUS=draft
