# BeatN — ship test builds to testers.
#
# EAS builds the app; Fastlane delivers it. Fastlane lives at the repo root
# rather than ios/fastlane because ios/ and android/ are regenerated by
# `expo prebuild` (Continuous Native Generation) and would wipe it.
#
#   bundle exec fastlane ios beta              build on EAS → TestFlight
#   bundle exec fastlane ios beta latest:true  re-ship the last beta build
#   bundle exec fastlane android internal      build on EAS → Play internal testing
#   bundle exec fastlane android closed        build on EAS → Play closed testing
#
# Credentials come from fastlane/.env (copy fastlane/.env.example).

require "json"
require "open3"

skip_docs # don't generate fastlane/README.md on every run

default_platform(:ios)

EAS_PROFILE = "beta"
BUILD_DIR = File.expand_path("../build", __dir__)
EAS = %w[npx eas-cli@latest].freeze

# Runs an EAS command that prints JSON on stdout.
#
# Fastlane's own `sh` merges stderr into the output, and EAS prints progress
# to stderr, which would corrupt the JSON. Open3 keeps the two apart.
def eas_json(*args)
  stdout, stderr, status = Open3.capture3(*EAS, *args, "--json", "--non-interactive")
  UI.user_error!("EAS command failed: eas #{args.join(' ')}\n#{stderr}") unless status.success?
  JSON.parse(stdout)
rescue JSON::ParserError
  UI.user_error!("EAS did not return JSON for: eas #{args.join(' ')}\n#{stdout}")
end

# Starts a store-signed build on EAS and waits for it. Returns the build record.
def build_on_eas(platform)
  UI.message("Building #{platform} on EAS with the '#{EAS_PROFILE}' profile (this takes a while)…")
  builds = eas_json("build", "--platform", platform, "--profile", EAS_PROFILE, "--wait")
  Array(builds).first || UI.user_error!("EAS returned no build")
end

# The most recent finished store-signed beta build, without rebuilding.
def latest_eas_build(platform)
  builds = eas_json(
    "build:list",
    "--platform", platform,
    "--build-profile", EAS_PROFILE,
    "--distribution", "store",
    "--status", "finished",
    "--limit", "1",
  )
  builds.first || UI.user_error!(
    "No finished '#{EAS_PROFILE}' build for #{platform} on EAS. " \
    "Run the lane without latest:true to build one.",
  )
end

# Downloads a build's artifact into build/ and returns the local path.
def download_artifact(build, extension)
  url = build.dig("artifacts", "buildUrl") ||
        UI.user_error!("EAS build #{build['id']} has no downloadable artifact")
  FileUtils.mkdir_p(BUILD_DIR)
  path = File.join(BUILD_DIR, "beatn-#{build['platform'].downcase}-#{build['id']}.#{extension}")
  sh("curl", "--fail", "--location", "--silent", "--show-error", "--output", path, url)
  path
end

def build_for(platform, options)
  options[:latest] ? latest_eas_build(platform) : build_on_eas(platform)
end

platform :ios do
  desc "Build on EAS and upload to TestFlight"
  desc "Options: latest:true (reuse the last beta build), changelog:\"What to test\""
  lane :beta do |options|
    ipa = download_artifact(build_for("ios", options), "ipa")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    # Internal testers (App Store Connect users) get every processed build
    # automatically. External groups need Apple's beta review, so they are
    # only distributed to when explicitly named.
    groups = ENV.fetch("TESTFLIGHT_GROUPS", "").split(",").map(&:strip).reject(&:empty?)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      changelog: options[:changelog] || "Latest BeatN test build.",
      groups: groups.empty? ? nil : groups,
      distribute_external: !groups.empty?,
      notify_external_testers: !groups.empty?,
      # Waiting is only needed to hand the build to external groups.
      skip_waiting_for_build_processing: groups.empty?,
    )
  end
end

platform :android do
  desc "Build on EAS and upload to Play internal testing (up to 100 testers, no review)"
  lane :internal do |options|
    ship_to_play(track: "internal", options: options)
  end

  desc "Build on EAS and upload to Play closed testing"
  desc "This is the track Google's '12 testers for 14 days' rule counts for new personal accounts"
  lane :closed do |options|
    ship_to_play(track: "alpha", options: options) # Play names closed testing 'alpha'
  end

  private_lane :ship_to_play do |params|
    aab = download_artifact(build_for("android", params[:options]), "aab")

    upload_to_play_store(
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      aab: aab,
      track: params[:track],
      # Google only accepts 'draft' releases until the app has completed its
      # first-time Play Console setup. Switch to 'completed' afterwards so
      # testers receive builds without a manual click.
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "draft"),
      # Test lanes ship the binary only; store listing is managed separately.
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
